# PS5 Management Server - Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8080
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default, file-based)
DATABASE_URL=sqlite:////app/data/ps5_manager.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@db:5432/ps5_manager

# MySQL (production)
# DATABASE_URL=mysql+pymysql://user:password@db:3306/ps5_manager

# =============================================================================
# STORAGE PATHS (relative to container /app or host project root)
# =============================================================================
SERVER_GAMES_PATH=/app/data/games
SERVER_SAVES_PATH=/app/data/saves
SERVER_ARTWORK_PATH=/app/data/artwork
SERVER_DOWNLOADS_PATH=/app/data/downloads

# For local development (outside Docker):
# SERVER_GAMES_PATH=./data/games
# SERVER_SAVES_PATH=./data/saves
# SERVER_ARTWORK_PATH=./data/artwork
# SERVER_DOWNLOADS_PATH=./data/downloads

# =============================================================================
# FTP DEFAULTS (for PS5 connections)
# =============================================================================
DEFAULT_FTP_PORT=21
DEFAULT_FTP_USER=ftp
DEFAULT_FTP_PASS=ftp

# =============================================================================
# TORRENT CLIENTS
# =============================================================================
# qBittorrent
QBITTORRENT_HOST=http://localhost:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# Transmission
TRANSMISSION_HOST=http://localhost:9091
TRANSMISSION_USER=
TRANSMISSION_PASS=

# =============================================================================
# API KEYS (get from respective services)
# =============================================================================
# IGDB API (https://api-docs.igdb.com/)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# RAWG API (https://rawg.io/apidocs)
RAWG_API_KEY=

# PSN API (https://github.com/isFakeAccount/psnawp)
# Get npsso from browser cookies after logging into playstation.com
PSN_NPSSO=

# =============================================================================
# PS5 EXPLOIT HOST SETTINGS
# =============================================================================
# Your server's LAN IP (for PS5 DNS configuration)
EXPLOIT_HOST_IP=192.168.8.50
EXPLOIT_DNS_PORT=53
EXPLOIT_HTTPS_PORT=443

# =============================================================================
# WEB STORE API ENDPOINTS
# =============================================================================
ORBIT_STORE_API=https://api.orbit-store.com
BLACKBOX_API=https://api.blackbox.com
OVERDRIVE_API=https://api.overdrive.com